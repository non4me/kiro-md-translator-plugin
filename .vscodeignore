# Sources and dev tooling — the runtime is the esbuild bundle in out/
.kiro/**
.ai_docs/**
.claude/**
# Local AI tooling that is not tracked in git — it is invisible to `git status`,
# so nothing but this line stops vsce from shipping it (it was 417 KB of the
# 0.8.0 package before this rule, more than half the .vsix).
.superpowers/**
# Internal AI design/plan artefacts — never part of the shipped extension.
docs/superpowers/**
src/**
test/**
node_modules/**
.vscode/**
**/*.ts
**/*.map
*.log
npm-install.log
tsconfig.json
vitest.config.ts
vitest.e2e.config.ts
esbuild.mjs
# End-to-end layers: compiled host tests and their runner config. Dev-only gates,
# never part of the shipped extension.
out-e2e/**
.vscode-test/**
.vscode-test.mjs
esbuild.e2e.mjs
.gitignore
.vscodeignore
CLAUDE.md
# Comment sidecars are per-user annotation data, never a shipped artefact.
**/*.comments.json
